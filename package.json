{
  "name": "familygene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "predev": "npm run build --workspace @familygene/shared",
    "dev": "concurrently --kill-others-on-fail -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @familygene/api",
    "dev:web": "npm run dev --workspace @familygene/web",
    "build": "npm run build --workspace @familygene/shared && npm run build --workspace @familygene/api && npm run build --workspace @familygene/web",
    "test": "npm run test --workspace @familygene/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace @familygene/shared && npm run typecheck --workspace @familygene/api && npm run typecheck --workspace @familygene/web",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
